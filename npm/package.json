{
  "name": "@cpldxx/repo-atlas",
  "version": "0.1.0",
  "description": "Read a GitHub repository once and explore it as five layers, a mind map, and answers written from the code. Runs on your machine.",
  "bin": {
    "repo-atlas": "bin/repo-atlas.js"
  },
  "files": [
    "bin",
    "vendor"
  ],
  "engines": {
    "node": ">=18"
  },
  "config": {
    "pythonPackage": "repo-atlas"
  },
  "homepage": "https://repo-atlas-677.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpldxx/repo-atlas.git"
  },
  "bugs": "https://github.com/cpldxx/repo-atlas/issues",
  "keywords": [
    "codebase",
    "onboarding",
    "knowledge-graph",
    "visualization",
    "ollama",
    "claude"
  ],
  "scripts": {
    "prepack": "node scripts/vendor-wheel.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
